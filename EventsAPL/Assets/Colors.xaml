<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные фоны -->
    <SolidColorBrush x:Key="AppBackground" Color="#0F141A"/>
    <SolidColorBrush x:Key="AppSurface" Color="#171E26"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0A0F14"/>
    <SolidColorBrush x:Key="InputBg" Color="#121920"/>

    <!-- Границы -->
    <SolidColorBrush x:Key="AppBorder" Color="#232C38"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B97A6"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5A6472"/>

    <!-- Акцент (Кобальт) -->
    <SolidColorBrush x:Key="Accent" Color="#2E6BE6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#3B78F0"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#2456BC"/>
    <SolidColorBrush x:Key="AccentDim" Color="#1E2D4A"/>
    <SolidColorBrush x:Key="AccentOnDark" Color="#5B8DFF"/>

    <!-- Состояния -->
    <SolidColorBrush x:Key="Success" Color="#3FB950"/>
    <SolidColorBrush x:Key="Warning" Color="#D29922"/>
    <SolidColorBrush x:Key="Danger" Color="#F85149"/>
    <SolidColorBrush x:Key="Hover" Color="#1A2330"/>

</ResourceDictionary>