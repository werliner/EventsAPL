<Window x:Class="EventsAPL.Views.EventParticipantsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Участники мероприятия"
        Width="900" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppSurface}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AppBackground}" Padding="20" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding EventTitle, StringFormat='Участники: {0}'}" FontSize="20" FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,16,20,8">
            <RadioButton Content="Студенты" IsChecked="{Binding IsStudentMode, Mode=TwoWay}" GroupName="Mode" Style="{StaticResource NavItem}" Width="120" Margin="0,0,10,0"/>
            <RadioButton Content="Преподаватели" IsChecked="{Binding IsTeacherMode, Mode=TwoWay}" GroupName="Mode" Style="{StaticResource NavItem}" Width="150"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid Visibility="{Binding IsStudentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Группа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Number" Style="{StaticResource AppComboBox}" Width="200"/>
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{Binding AvailableStudents}" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Student.FullName}" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.ResultTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          SelectedItem="{Binding SelectedResultType}" DisplayMemberPath="Title" Style="{StaticResource AppComboBox}" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.ResultLevels, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          SelectedItem="{Binding SelectedResultLevel}" DisplayMemberPath="Title" Style="{StaticResource AppComboBox}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Visibility="{Binding IsTeacherMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView ItemsSource="{Binding AvailableTeachers}" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Teacher.FullName}" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.ResultTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          SelectedItem="{Binding SelectedResultType}" DisplayMemberPath="Title" Style="{StaticResource AppComboBox}" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.ResultLevels, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          SelectedItem="{Binding SelectedResultLevel}" DisplayMemberPath="Title" Style="{StaticResource AppComboBox}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource AppBackground}" Padding="20,16" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,12,0"/>
                <Button Content="Сохранить участников" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="180"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>