<Window x:Class="EventsAPL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EventsAPL.ViewModels"
        Title="Учёт мероприятий"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackground}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =============== ВЕРХНЯЯ ПАНЕЛЬ =============== -->
        <Border Grid.Row="0" Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Учёт мероприятий" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="{Binding UserDisplayName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>

                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Войти" Command="{Binding LoginCommand}" VerticalAlignment="Center" Padding="20,6"/>
            </Grid>
        </Border>

        <!-- =============== ОСНОВНАЯ ОБЛАСТЬ =============== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <!-- Внимание: здесь больше нет Width="72", всё ушло в Style -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource AppBorder}"
                    BorderThickness="0,0,1,0"
                    MouseEnter="Sidebar_MouseEnter"
                    MouseLeave="Sidebar_MouseLeave">

                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Базовая ширина -->
                        <Setter Property="Width" Value="72"/>
                        <Setter Property="MinWidth" Value="72"/>

                        <Style.Triggers>
                            <!-- Если IsSidebarExpanded == True, анимируем ширину до 240 -->
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" 
                                                             To="240" 
                                                             Duration="0:0:0.2" 
                                                             FillBehavior="HoldEnd"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <!-- Когда триггер отключается, анимируем обратно до 72 -->
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" 
                                                             To="72" 
                                                             Duration="0:0:0.2" 
                                                             FillBehavior="HoldEnd"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Мероприятия" Tag="&#xE787;" Command="{Binding NavigateCommand}" CommandParameter="Events" IsChecked="True" ToolTip="Мероприятия"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Группы" Tag="&#xE716;" Command="{Binding NavigateCommand}" CommandParameter="Groups" ToolTip="Группы"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Студенты" Tag="&#xE77B;" Command="{Binding NavigateCommand}" CommandParameter="Students" ToolTip="Студенты"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Преподаватели" Tag="&#xE7BE;" Command="{Binding NavigateCommand}" CommandParameter="Teachers" ToolTip="Преподаватели"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Справочники" Tag="&#xE8F1;" Command="{Binding NavigateCommand}" CommandParameter="Dictionaries" ToolTip="Справочники"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Журнал" Tag="&#xE81C;" Command="{Binding NavigateCommand}" CommandParameter="Log" ToolTip="Журнал действий"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Администрирование" Tag="&#xE713;" Command="{Binding NavigateCommand}" CommandParameter="Admin" ToolTip="Администрирование"/>
                </StackPanel>
            </Border>

            <!-- ============ ОБЛАСТЬ КОНТЕНТА ============ -->
            <Border Grid.Column="1" Margin="16" Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentIcon}" FontFamily="Segoe MDL2 Assets" FontSize="64" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentTitle}" FontSize="28" FontWeight="Bold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Раздел в разработке" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>